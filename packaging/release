#!/bin/zsh
set -euo pipefail

project_dir="${0:A:h:h}"
cd "$project_dir"

if [[ "${1:-}" = --help || "${1:-}" = -h ]]; then
  print "Usage: packaging/release [version]"
  print "Dispatch the GitHub Actions release flow."
  exit 0
fi
if (( $# > 1 )); then
  print -u2 "Usage: packaging/release [version]"
  exit 2
fi
exec packaging/tag-release "$@"
