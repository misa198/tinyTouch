#!/bin/zsh
set -euo pipefail

project_dir="${0:A:h:h}"
cd "$project_dir"

if [[ "${1:-}" = --help || "${1:-}" = -h ]]; then
  print "Usage: packaging/tag-release [version]"
  print "Dispatch the GitHub Actions tag workflow."
  exit 0
fi
if (( $# > 1 )); then
  print -u2 "Usage: packaging/tag-release [version]"
  exit 2
fi

version="${1:-}"
if [[ -z "$version" ]]; then
  current="$(tr -d '[:space:]' < VERSION)"
  version="${current%.*}.$(( ${current##*.} + 1 ))"
fi
gh workflow run firmware-tag.yml --ref master -f "version=$version"
print "Dispatched v$version; GitHub Actions will commit VERSION, tag, build, and release it."
